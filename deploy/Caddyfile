{$PUBLIC_HOST} {
    encode zstd gzip
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
